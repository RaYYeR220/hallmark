{
  "name": "@hallmark/prober",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sweeps ERC-8004 agents on BNB Smart Chain, contacts their declared endpoints, scores what answers, and publishes the evidence on-chain.",
  "bin": {
    "hallmark-probe": "./bin/hallmark-probe.js"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "probe": "node --experimental-strip-types --no-warnings src/cli.ts",
    "serve": "node --experimental-strip-types --no-warnings src/cli.ts serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@hallmark/core": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5",
    "vitest": "^2"
  },
  "engines": {
    "node": ">=22.6"
  }
}
