# hallmark-prober
#
# Every command except `publish --commit` runs with this file empty. Copy it to
# .env and fill in only what you need. Never commit real values.

# --- RPC ------------------------------------------------------------------
# Defaults are the public nodes @hallmark/core ships with. A private endpoint
# is strongly recommended for a full-registry sweep.
RPC_URL_56=
RPC_URL_97=

# --- 8004scan -------------------------------------------------------------
# Optional. Without a key the client uses the anonymous limits (180/min on the
# front door) and falls back to the official API when the front door 500s.
# Our key is tier free_api: 600/min, 100k/day.
SCAN_API_KEY=

# --- evidence -------------------------------------------------------------
# Where published bundles are fetchable. This exact prefix ends up inside every
# on-chain attestation, so it must resolve publicly and return byte-identical
# content. Bundles are served by the marketplace app; point this at
# http://localhost:8787 to use `hallmark-probe serve` locally instead.
EVIDENCE_BASE_URL=https://hallmark-market.vercel.app/api/evidence

# Where run records and evidence documents are written. The marketplace app
# reads bundles from <STORE_DIR>/evidence/<hash>.json.
STORE_DIR=./data

# --- keys -----------------------------------------------------------------
# Only `publish --commit` reads these. The HallmarkHook funding gate credits
# evidence from the attestor address only, and it looks for validations where
# validator == attestor, so in practice these two are the same key.
ATTESTOR_PRIVATE_KEY=
VALIDATOR_PRIVATE_KEY=

# Optional, and only for agents we own. `validationRequest` reverts
# "Not authorized" unless the caller owns or operates the agent, so this is the
# opt-in half of the validation cycle.
AGENT_OWNER_PRIVATE_KEY=

# --- contracts ------------------------------------------------------------
# HallmarkHook. Testnet has a default; mainnet is not deployed.
HALLMARK_HOOK_97=0xc240452ef94071Df0c6740Dd3c86aeb0Ca374798
HALLMARK_HOOK_56=

# --- server ---------------------------------------------------------------
PORT=8787
# Bearer token for POST /api/cron/sweep. The route is disabled while unset.
CRON_SECRET=

# --- spend ceilings -------------------------------------------------------
# Hard budget guards, in wei, checked before every write. Defaults are
# 0.0015 BNB per run and 0.0035 BNB across every run this store remembers.
BUDGET_WEI_PER_RUN=1500000000000000
BUDGET_WEI_TOTAL=3500000000000000

# --- probe tuning ---------------------------------------------------------
PROBE_TIMEOUT_MS=5000
# Registration files are fetched on their own, longer deadline: a card fetch is
# a document fetch, not a latency measurement, and starving it hides endpoints.
PROBE_CARD_TIMEOUT_MS=15000
PROBE_CONCURRENCY=20
PROBE_MAX_REDIRECTS=3
PROBE_MAX_BODY_BYTES=2097152
# Resolve hostnames and refuse the ones that point into private space. Turning
# this off removes the only defence against DNS rebinding.
PROBE_CHECK_DNS=true
PROBE_RESOLVE_OFFCHAIN=true
