{
  "name": "@hallmark/agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Five live BNB Chain agents behind one runtime: A2A, MCP and x402 faces, every value-moving call bounded by an Altana session key.",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "register": "tsx scripts/register.ts",
    "prove": "tsx scripts/prove.ts",
    "session": "tsx scripts/session.ts"
  },
  "dependencies": {
    "@hallmark/altana": "workspace:*",
    "@hallmark/core": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.11"
  }
}
