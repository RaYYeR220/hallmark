# Every variable here is optional. What is missing degrades to the cautious
# option — see the table in README.md — and the startup banner lists what is
# not configured and what the service will therefore refuse.

# --- identity ---------------------------------------------------------------
# The origin every absolute URL is built from. One variable, so a preview
# deployment never registers cards pointing at production.
PUBLIC_BASE_URL=https://hallmark-agents.vercel.app
HALLMARK_MARKETPLACE_URL=https://hallmark-market.vercel.app
HALLMARK_CHAIN_ID=56

# --- x402 -------------------------------------------------------------------
# Where payments settle. Unset, the x402 face answers 503 rather than quote a
# challenge that would send funds to the zero address.
X402_PAY_TO=
# A facilitator serving /verify and /settle. Unset, a presented payment is
# refused with the reason — the work is never served on an unverified header.
X402_FACILITATOR_URL=

# --- scheduling -------------------------------------------------------------
# Guards /api/cron/{agent}. Unset, that endpoint refuses every request; it does
# not fall back to running unauthenticated.
CRON_SECRET=

# --- session keys -----------------------------------------------------------
# Two variables per category, split on purpose: the serialized session carries
# no key material and is safe to log; the private key is not. Unset, `act`
# answers `aborted / no-session` with the calls it would have sent.
#
# Categories: REBALANCE, GRID, YIELD, HEALTH.
# HALLMARK_SESSION_HEALTH={"walletAddress":"0x…","publicKey":"0x…","permissions":{…},"expiry":…}
# HALLMARK_SESSION_KEY_HEALTH=0x…

# --- storage ----------------------------------------------------------------
# A path switches the store from memory to a JSON file, which is what a
# long-lived process needs for grid state and intent idempotency to survive a
# restart.
HALLMARK_STORE_PATH=

# --- optional ---------------------------------------------------------------
# Etherscan's V2 API charges for BNB Chain, so source verification reports
# `unknown` without a key rather than guessing.
BSCSCAN_API_KEY=
BSC_RPC_URL=
BSC_TESTNET_RPC_URL=
