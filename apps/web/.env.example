# ---------------------------------------------------------------------------
# Hallmark web — environment
#
# Every variable below is optional. The app boots and every page renders
# without a single one of them; each variable widens what the app can do or
# raises a rate limit. Anything prefixed NEXT_PUBLIC_ ends up in the browser
# bundle — nothing secret may ever be given that prefix.
# ---------------------------------------------------------------------------

# --- 8004scan indexer -------------------------------------------------------
# The public front door needs no key and allows 180 requests/minute. A key
# raises that to 600/minute. Server-side only: the browser never sees it,
# because every index read goes through a route handler under /api.
SCAN_API_KEY=
# Override the indexer base. Defaults to https://8004scan.io/api/v1 with
# https://api.8004scan.io/api/v1 as the automatic cross-over fallback.
SCAN_BASE_URL=

# --- RPC --------------------------------------------------------------------
# Public nodes are the default and work unauthenticated. Set these to a
# dedicated provider before a demo: the public nodes rate-limit hard and the
# agent list issues one multicall per page.
RPC_URL_56=
RPC_URL_97=

# --- Sponsored demo hire ----------------------------------------------------
# A server-funded hire on BNB testnet (chain 97) so someone with no wallet can
# run the whole cycle. Leave SPONSOR_PRIVATE_KEY empty and the button is
# rendered as unavailable with an explanation rather than failing at click
# time. The key must hold testnet BNB (relay + gas) and testnet $U (escrow).
#
# NEVER point this at a mainnet key. The app refuses any chain but 97.
SPONSOR_PRIVATE_KEY=
# Hard ceiling on a single sponsored job, in whole $U. Default 5.
SPONSOR_MAX_BUDGET_U=5
# Sponsored hires allowed per IP per hour. Default 3.
SPONSOR_RATE_LIMIT_PER_HOUR=3

# --- Proof page -------------------------------------------------------------
# The reverted `fund` transaction that proves the evidence gate bites, as a
# 0x-prefixed hash on chain 97. Until one exists the proof page says so and
# shows the live `isHireable` read instead, which is the same claim without a
# receipt. Fill this in as soon as the first refusal is on-chain.
NEXT_PUBLIC_REFUSAL_TX_97=

# The settled job used as the worked example on /proof, if there is one.
NEXT_PUBLIC_SETTLED_JOB_ID_97=

# --- Deployment -------------------------------------------------------------
# Canonical origin, used for absolute URLs in metadata. Vercel sets
# VERCEL_URL automatically; this only matters for a custom domain.
NEXT_PUBLIC_SITE_URL=
