# Deployer key. Becomes the owner of both contracts.
PRIVATE_KEY=0x

# Platform fee recipient.
TREASURY=0x

# Hallmark prober. Only this address can call recordProbe, and only its
# validations and probes count as liveness evidence.
ATTESTOR=0x

# Optional. Platform fee in basis points, charged on complete only. Max 1000.
FEE_BPS=250

# Optional. Prefix for the evidence document referenced by written feedback;
# the job id is appended to it.
EVIDENCE_BASE_URI=https://hallmark.xyz/evidence/

# Optional. Overrides the $U payment token for the target chain.
# PAYMENT_TOKEN=0x

# Used by forge verify-contract against the unified Etherscan v2 endpoint.
ETHERSCAN_API_KEY=
